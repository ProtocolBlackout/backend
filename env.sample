MONGODB_URL=
DATABASE=
PORT=
JWT_SECRET=
JWT_EXPIRES_IN=

# SMTP (Fallback, nur wenn Gmail nicht vollständig konfiguriert ist)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Gmail API (bevorzugt, wenn vollständig gesetzt)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
GMAIL_FROM=

# Öffentliche Backend-URL
BACKEND_PUBLIC_URL=

# Öffentliche Frontend-URL 
FRONTEND_PUBLIC_URL=

# Rate Limiter (nur für Tests/CI)
# Setze das in .env.test auf "true", damit Tests nicht durch 429 (Rate Limit) fehlschlagen.
# In .env / Production NICHT aktivieren!
RATE_LIMITER_DISABLED=